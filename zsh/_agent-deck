#compdef agent-deck
# ---------------------------------------------------------------------------
# zsh completion for agent-deck — terminal session manager for AI coding agents
#   https://github.com/asheshgoplani/agent-deck
#
# Generated against agent-deck v1.16.4 (commands and flags taken from the
# CLI's own flag sets in cmd/agent-deck/*.go).
#
# Install: keep this file as `_agent-deck` in a directory on $fpath, then
#   rm -f ~/.zcompdump*; exec zsh
#
# Dynamic completions (sessions, groups, MCPs, skills, profiles, remotes,
# plugins, conductors, experiments) are read from `agent-deck ... --json` and
# honour an explicit `-p/--profile` earlier on the command line.
# ---------------------------------------------------------------------------

_agent-deck() {
  local curcontext=$curcontext state line ret=1
  typeset -A opt_args
  typeset -ga __agent_deck_gopts

  __agent_deck_scan_gopts

  _arguments -C \
    '(- 1 *)'{-h,--help}'[show help]' \
    '(- 1 *)'{-v,--version}'[show version]' \
    '(-p --profile)'{-p,--profile}'[use a specific profile]:profile:__agent_deck_profiles' \
    '(-g --group)'{-g,--group}'[launch the TUI scoped to a group]:group:__agent_deck_groups' \
    '--select[launch the TUI with the cursor on a session]:session:__agent_deck_sessions' \
    '1:command:__agent_deck_commands' \
    '*:: :->args' && ret=0

  [[ $state == args ]] || return ret

  curcontext="${curcontext%:*:*}:agent-deck-${words[1]}:"

  case ${words[1]} in
    add)              __agent_deck_add && ret=0 ;;
    launch)           __agent_deck_launch && ret=0 ;;
    try)              __agent_deck_try && ret=0 ;;
    list|ls)          _arguments -s '--json[output as JSON]' '--all[list sessions from all profiles]' && ret=0 ;;
    remove|rm)        _arguments -s $__agent_deck_common_opts '1:session:__agent_deck_sessions' && ret=0 ;;
    rename|mv)        _arguments -s $__agent_deck_common_opts '1:session:__agent_deck_sessions' '2:new title:' && ret=0 ;;
    status)
      _arguments -s $__agent_deck_common_opts \
        '(-v --verbose)'{-v,--verbose}'[show a detailed session list]' \
        '--stale[list stale-session candidates; read-only, never stops or removes]' \
        '--threshold[staleness window for --stale]:duration:(24h 48h 168h)' && ret=0
      ;;
    session)          __agent_deck_session && ret=0 ;;
    fleet)            __agent_deck_fleet && ret=0 ;;
    mcp)              __agent_deck_mcp && ret=0 ;;
    skill)            __agent_deck_skill && ret=0 ;;
    plugin)           __agent_deck_plugin && ret=0 ;;
    group)            __agent_deck_group && ret=0 ;;
    worktree|wt)      __agent_deck_worktree && ret=0 ;;
    remote)           __agent_deck_remote && ret=0 ;;
    conductor)        __agent_deck_conductor && ret=0 ;;
    profile)          __agent_deck_profile && ret=0 ;;
    web)              __agent_deck_web && ret=0 ;;
    costs)            __agent_deck_costs && ret=0 ;;
    watcher)          __agent_deck_watcher && ret=0 ;;
    openclaw|oc)      __agent_deck_openclaw && ret=0 ;;
    inbox)
      _arguments -C '1:subcommand:((drain\:"drain and print pending events" export\:"export records without consuming" writer-status\:"check if a writer is recording"))' '*:: :->iargs' && ret=0
      [[ $state == iargs ]] && {
        case ${words[1]} in
          drain)         _arguments -s '--json[output as JSON]' '1:session:__agent_deck_sessions' && ret=0 ;;
          export|writer-status)
                         _arguments -s '--json[output as JSON]' && ret=0 ;;
          *) _arguments -s '--json[output as JSON]' '1:session:__agent_deck_sessions' && ret=0 ;;
        esac
      }
      ;;
    hooks|codex-hooks|gemini-hooks|hermes-hooks|cursor-hooks)
      __agent_deck_hooks && ret=0 ;;
    telegram-doctor)  _arguments -s '--json[emit machine-readable JSON]' '--quiet[only print drift]' && ret=0 ;;
    accounts)
      _arguments -s '--json[output as JSON]' && ret=0 ;;
    agents)
      _arguments -s '--json[output as JSON]' '--no-remote[skip remote machines]' && ret=0 ;;
    agent)            __agent_deck_agent && ret=0 ;;
    doctor)
      _arguments -s '--json[output as JSON]' && ret=0 ;;
    telemetry)        __agent_deck_telemetry && ret=0 ;;
    deepseek)         __agent_deck_deepseek && ret=0 ;;
    remote-agent)
      _arguments -s '-h[show help]' '--help[show help]' && ret=0 ;;
    update)
      _arguments -s '--check[only check, do not install]' \
        '--version[install a specific released version]:version:' && ret=0
      ;;
    migrate-paths)
      _arguments -s '--dry-run[show what would be copied]' \
        '--force[merge legacy files into existing XDG locations]' && ret=0
      ;;
    uninstall)
      _arguments -s '--dry-run[show what would be removed]' \
        '--keep-data[keep config/data/cache locations]' \
        '--keep-tmux-config[keep the tmux configuration]' \
        '-y[skip confirmation prompts]' && ret=0
      ;;
    help)
      _arguments '1:command:__agent_deck_commands' && ret=0 ;;
  esac

  return ret
}

# Capture an explicit -p/--profile from the words before the subcommand, so the
# dynamic helpers below query the profile the user is actually talking about.
# Only the leading global-option run is scanned: `add -p` means --parent, and
# `group reorder -p` means --position.
__agent_deck_scan_gopts() {
  typeset -ga __agent_deck_gopts
  __agent_deck_gopts=()
  local i=2 w
  while (( i < CURRENT )); do
    w=${words[i]}
    case $w in
      -p|--profile)
        (( i + 1 < CURRENT )) && __agent_deck_gopts=(--profile "${words[i+1]}")
        (( i += 2 )) ;;
      -p=*|--profile=*)
        __agent_deck_gopts=(--profile "${w#*=}"); (( i++ )) ;;
      -g|--group|--select)      (( i += 2 )) ;;
      -g=*|--group=*|--select=*) (( i++ )) ;;
      -*)                       (( i++ )) ;;
      *) break ;;   # first positional word is the subcommand
    esac
  done
}

# Pull every value of a JSON string field out of an agent-deck --json payload.
# Handles both the pretty-printed (MarshalIndent) and compact shapes, and
# quietly yields nothing when the command prints a plain "none found" message.
__agent_deck_json_field() {
  local key=$1; shift
  (( $+commands[agent-deck] )) || return 1
  agent-deck "${__agent_deck_gopts[@]}" "$@" 2>/dev/null |
    grep -o "\"${key}\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" 2>/dev/null |
    sed -e 's/^[^:]*:[[:space:]]*"//' -e 's/"$//'
}

