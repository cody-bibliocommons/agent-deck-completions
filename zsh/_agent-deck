  _describe -t commands 'agent-deck command' cmds
}

__agent_deck_sessions() {
  local -a lines cands
  local line id title sstate rest
  lines=( ${(f)"$(agent-deck "${__agent_deck_gopts[@]}" list --json 2>/dev/null | awk -F'"' '
      /"id"[[:space:]]*:/     { id = $4 }
      /"title"[[:space:]]*:/  { title = $4 }
      /"status"[[:space:]]*:/ { if (id != "") { print id "\t" title "\t" $4; id = ""; title = "" } }
    ')"} )

  for line in $lines; do
    id=${line%%$'\t'*}
    rest=${line#*$'\t'}
    title=${rest%%$'\t'*}
    sstate=${rest##*$'\t'}
    [[ -n $title ]] && cands+=( "${title//:/\\:}:${sstate}" )
    cands+=( "${id//:/\\:}:${title:-session} (${sstate})" )
  done

  _describe -t sessions 'session' cands
}

__agent_deck_groups() {
  local -a groups
  groups=( ${(f)"$(__agent_deck_json_field path group list --json)"} )
  _describe -t groups 'group' groups
}

__agent_deck_profiles() {
  local -a profiles
  profiles=( ${(f)"$(__agent_deck_json_field name profile list --json)"} )
  _describe -t profiles 'profile' profiles
}

__agent_deck_mcps() {
  local -a mcps
  mcps=( ${(f)"$(__agent_deck_json_field name mcp list --json)"} )
  _describe -t mcps 'MCP' mcps
}

__agent_deck_skills() {
  local -a skills
  skills=( ${(f)"$(__agent_deck_json_field name skill list --json)"} )
