__agent_deck_experiments() {
  local -a exps
  exps=( ${(f)"$(__agent_deck_json_field name try --list --json)"} )
  _describe -t experiments 'experiment' exps
}

# Upstream's builtinToolValues, plus two deliberate extras: `shell` (a valid
# --cmd, not a builtin tool) and `kiro-cli` (upstream's feat/kiro-cli-tool
# branch, not yet on main). --cmd takes an arbitrary command, so neither can be
# wrong; tools/check-coverage.py holds this list to the snapshot.
__agent_deck_tools() {
  local -a tools
  tools=(
    'claude:Claude Code'
    'codex:OpenAI Codex CLI'
    'deepseek:DeepSeek Harness (dsh)'
    'gemini:Gemini CLI'
    'opencode:OpenCode'
    'copilot:GitHub Copilot CLI'
    'crush:Crush'
    'cursor:Cursor Agent CLI'
    'hermes:Hermes Agent'
    'kiro-cli:Kiro CLI (AWS)'
    'pi:Pi'
    'shell:plain shell'
  )
  _describe -t tools 'tool' tools
}

__agent_deck_branches() {
  local -a branches
  branches=( ${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"} )
  _describe -t branches 'branch' branches
}

__agent_deck_worktree_location() {
  _alternative \
    'locations:location:((sibling\:"next to the repo" subdirectory\:"inside .worktrees/"))' \
    'directories:custom path:_files -/'
}

__agent_deck_session_fields() {
  local -a fields
  fields=(
    'title:session title'
    'path:project path'
    'command:command to run'
    'tool:tool type (claude, gemini, shell, …)'
    'wrapper:wrapper command, {command} expands to the tool command'
    'channels:comma-separated plugin channel ids (claude only)'
    'plugins:comma-separated plugin catalog names (claude only)'
    'extra-args:extra claude CLI tokens (claude only)'
    'model:per-session model override'
    'color:TUI row tint (#RRGGBB or ANSI 0..255)'
    'claude-session-id:Claude conversation id'
    'gemini-session-id:Gemini conversation id'
    'account:named account slot'
    'idle-timeout:auto-stop after this much tmux silence'
  )
  _describe -t fields 'field' fields
}

# Option specs shared by many subcommands. These are static, so they are built
# once when this file loads rather than on every keystroke.
typeset -ga __agent_deck_common_opts __agent_deck_create_opts

__agent_deck_common_opts=(
  '--json[output as JSON]'
  '(-q --quiet)'{-q,--quiet}'[minimal output]'
)

# Shared by `add` and `launch`.
__agent_deck_create_opts=(
  $__agent_deck_common_opts
  '(-c --cmd)'{-c,--cmd}'[tool/command to run]:tool:__agent_deck_tools'
  '(-t --title)'{-t,--title}'[session title]:title:'
  '(-g --group)'{-g,--group}'[group path]:group:__agent_deck_groups'
  '(-p --parent)'{-p,--parent}'[parent session (creates a sub-session)]:session:__agent_deck_sessions'
  '--model[model id/version for this session]:model:'
  '(-w --worktree)'{-w,--worktree}'[create the session in a git worktree for this branch]:branch:__agent_deck_branches'
  '(-b --new-branch)'{-b,--new-branch}'[create a new branch (with --worktree)]'
  '--location[worktree location]:location:__agent_deck_worktree_location'
  '*--mcp[MCP to attach (repeatable)]:mcp:__agent_deck_mcps'
  '*--plugin[catalog plugin to enable (repeatable, claude only)]:plugin:__agent_deck_plugins'
  '*--channel[plugin channel id (repeatable, claude only)]:channel:'
  '*--extra-arg[extra claude CLI token (repeatable, claude only)]:token:'
  '--no-channel-link[do not auto-link --plugin channels to --channel]'
  '--no-parent[disable automatic parent linking]'
  '--no-title-sync[alias for --title-lock]'
  '--title-lock[keep Claude from overriding the session title]'
  '--no-transition-notify[suppress transition notifications to the parent]'
  '--resume-session[Claude session id to resume]:session id:'
  '--tmux-socket[tmux -L socket name for this session]:socket:'
)

__agent_deck_add() {
  _arguments -s $__agent_deck_create_opts \
    '(-Q --quick)'{-Q,--quick}'[create a quick session with a generated handle]' \
    '--attach[start and attach to the session immediately]' \
    '--account[named account slot]:account:' \
    '--sandbox[run the session in a Docker sandbox]' \
    '--sandbox-image[Docker image for the sandbox]:image:' \
    '--ssh[SSH destination]:destination:_ssh_hosts' \
    '--remote-path[remote working directory (with --ssh)]:path:_files -/' \
    '--wrapper[wrapper command, {command} expands to the tool command]:wrapper:' \
    '--yolo[enable YOLO mode for Gemini or Codex sessions]' \
    '--gemini-yolo[alias for --yolo]' \
    '--create-dir[create the project directory if it does not exist]' \
    '::project directory:_files -/'
}

__agent_deck_launch() {
  _arguments -s $__agent_deck_create_opts \
    '(-m --message)'{-m,--message}'[initial message to send once the agent is ready]:message:' \
    '--message-file[read the initial message from a file (- for stdin)]:file:_files' \
    '--assert-done[append a completion-sentinel instruction to the message]' \
    '--no-assert-done[disable the completion-sentinel instruction]' \
    '--no-wait[do not wait for the agent to be ready before sending]' \
    '--idle-timeout[auto-stop after this much tmux silence (30m, 1h, …)]:duration:' \
    '--inherit-group[place the child in the parent session'\''s group]' \
    '--inherit-telegram-env[keep TELEGRAM_* env vars in the child]' \
    '--wrapper[wrapper command, {command} expands to the tool command]:wrapper:' \
    '--account[named account slot]:account:' \
    '::project directory:_files -/'
}

__agent_deck_try() {
  _arguments -s $__agent_deck_common_opts \
    '(-c --cmd)'{-c,--cmd}'[AI tool to use]:tool:__agent_deck_tools' \
    '(-l --list)'{-l,--list}'[list experiments without creating a session]' \
    '--no-session[create the folder only, do not start a session]' \
    '--sandbox[run the session in a Docker sandbox]' \
    '::experiment name:__agent_deck_experiments'
}

__agent_deck_session() {
  local curcontext=$curcontext state line ret=1
  typeset -A opt_args
  local -a subcmds

  subcmds=(
    'start:start a session'\''s tmux process'
    'stop:stop the session process'
    'remove:remove a session from the registry'
    'cleanup:purge dead sessions idle N+ days'
    'prune:purge dead sessions idle N+ days'
    'archive:stop a session and hide it from active lists'
    'unarchive:restore an archived session'
    'restart:restart a session (Claude reloads MCPs)'
    'revive:rebuild dead control pipes for errored sessions'
    'fork:fork a session with its context'
    'handoff:build a cross-tool handoff prompt'
    'attach:attach to a session interactively'
    'focus:tell the running TUI to select a session'
    'show:show session details'
    'current:show the current session and profile'
    'set:update a session property'
    'switch-account:switch Claude account and migrate the conversation'
    'move:move a session to a new path'
    'mv:move a session to a new path'
    'send:send a message to a running session'
    'send-keys:send raw keystrokes to a session'
    'approve:resolve a visible Codex approval prompt'
    'output:get the last response from a session'
    'children:list sub-sessions with status'
    'search:search message content across Claude sessions'
    'set-parent:link a session as a sub-session of a parent'
    'unset-parent:remove a sub-session link'
    'update:alias for set-parent/unset-parent'
    'set-transition-notify:enable/disable transition notifications'
    'set-title-lock:lock/unlock the title from Claude session-name sync'
    'help:show session help'
  )

  _arguments -C \
    '1:subcommand:->subcmd' \
    '*:: :->args' && ret=0

  case $state in
    subcmd) _describe -t session-commands 'session command' subcmds && ret=0 ;;
    args)
      case ${words[1]} in
        start)
          _arguments -s $__agent_deck_common_opts \
            '(-m --message)'{-m,--message}'[initial message to send once ready]:message:' \
            '--message-file[read the initial message from a file]:file:_files' \
            '--attach[attach to the session after starting]' \
            '--yolo[enable YOLO mode for Gemini or Codex]' \
            '--no-wait[do not wait for the agent to be ready before sending]' \
            '1:session:__agent_deck_sessions' && ret=0
          ;;
        stop|archive|unarchive|unset-parent|show)
          _arguments -s $__agent_deck_common_opts '1:session:__agent_deck_sessions' && ret=0
          ;;
        current)
          _arguments -s $__agent_deck_common_opts && ret=0
          ;;
        attach)
          _arguments '1:session:__agent_deck_sessions' && ret=0
          ;;
        focus)
          _arguments '--attach[attach instead of only selecting]' \
            '1:session:__agent_deck_sessions' && ret=0
          ;;
        remove)
          _arguments -s $__agent_deck_common_opts \
            '--force[remove even when the session is not stopped]' \
            '--all-errored[remove every errored session]' \
            '--prune-worktree[also remove the session'\''s git worktree]' \
            '1:session:__agent_deck_sessions' && ret=0
          ;;
        cleanup|prune)
          _arguments -s $__agent_deck_common_opts \
            '--days[purge sessions idle at least this many days]:days:' \
            '--dry-run[show what would be purged]' \
            '(-y --yes)'{-y,--yes}'[actually purge instead of dry-running]' \
            '--force[skip safety checks]' \
            '--include-archived[also consider archived sessions]' \
            '--prune-worktree[also remove git worktrees]' && ret=0
          ;;
        restart)
          _arguments -s $__agent_deck_common_opts \
            '--all[restart every active session]' \
            '*--env[set an env var for the restarted session]:KEY=VALUE:' \
            '--force[restart even when the session looks busy]' \
            '1:session:__agent_deck_sessions' && ret=0
          ;;
        revive)
          _arguments -s $__agent_deck_common_opts \
            '--all[revive every errored session]' \
            '--name[revive by session name]:name:__agent_deck_sessions' && ret=0
          ;;
        fork)
          _arguments -s $__agent_deck_common_opts \
            '(-t --title)'{-t,--title}'[title for the fork]:title:' \
            '(-g --group)'{-g,--group}'[group for the fork]:group:__agent_deck_groups' \
            '(-w --worktree)'{-w,--worktree}'[create the fork in a git worktree]:branch:__agent_deck_branches' \
            '(-b --new-branch)'{-b,--new-branch}'[create a new branch for the worktree]' \
            '--sandbox[run the fork in a Docker sandbox]' \
            '--sandbox-image[Docker image for the sandbox]:image:' \
            '--with-state[copy untracked working state into the fork]' \
            '--with-state-and-gitignored[copy untracked and gitignored state]' \
            '1:session:__agent_deck_sessions' && ret=0
          ;;
        handoff)
          _arguments -s '--json[output as JSON]' \
            '--max-chars[cap the handoff prompt length]:chars:' \
            '--out[write the prompt to a file]:file:_files' \
            '1:session:__agent_deck_sessions' && ret=0
          ;;
        set)
          _arguments -s $__agent_deck_common_opts \
            '1:session:__agent_deck_sessions' \
            '2:field:__agent_deck_session_fields' \
            '*:value:' && ret=0
          ;;
        switch-account)
          _arguments -s $__agent_deck_common_opts \
            '--no-restart[do not restart the session afterwards]' \
            '1:session:__agent_deck_sessions' \
            '2:account:' && ret=0
          ;;
        move|mv)
          _arguments -s $__agent_deck_common_opts \
            '--group[target group]:group:__agent_deck_groups' \
            '--to-profile[move the session to another profile]:profile:__agent_deck_profiles' \
            '--copy[copy instead of moving]' \
            '--force[move even when the session is running]' \
            '--no-restart[do not restart after moving]' \
            '1:session:__agent_deck_sessions' \
            '2:new path:_files -/' && ret=0
          ;;
        send)
          _arguments -s '--json[output as JSON]' '(-q --quiet)'{-q,--quiet}'[minimal output]' \
            '--message-file[read the message from a file (- for stdin)]:file:_files' \
            '--draft[type the message without submitting it]' \
            '--no-wait[do not wait for the agent to be ready]' \
            '--wait[wait for the agent to be ready]' \
            '--timeout[how long to wait for readiness]:duration:' \
            '--defer-if-busy[queue the message when the agent is busy]' \
            '--defer-timeout[how long to keep a deferred message queued]:duration:' \
            '--stream[stream the reply back]' \
            '--stream-idle[end the stream after this much silence]:duration:' \
            '--stream-char-budget[cap streamed characters]:chars:' \
            '--stream-tool-budget[cap streamed tool calls]:count:' \
            '1:session:__agent_deck_sessions' \
            '*:message:' && ret=0
          ;;
        send-keys)
          _arguments -s '--json[output as JSON]' '(-q --quiet)'{-q,--quiet}'[minimal output]' \
            '--text[literal text to send]:text:' \
            '--named-key[tmux named key (BSpace, Up, C-c, …)]:key:' \
            '--enter[send Enter]' \
            '--stream[stream the reply back]' \
            '1:session:__agent_deck_sessions' && ret=0
