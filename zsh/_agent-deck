    'try:quick experiment in a dated folder'
    'list:list all sessions'
    'ls:list all sessions'
    'remove:remove a session'
    'rm:remove a session'
    'rename:rename a session'
    'mv:rename a session'
    'status:show a session status summary'
    'session:manage session lifecycle'
    'fleet:detect and recover from a fleet-wide session death'
    'mcp:manage MCP servers'
    'skill:manage project skills'
    'plugin:manage catalog plugins'
    'codex-hooks:manage the Codex notify hook integration'
    'gemini-hooks:manage the Gemini hook integration'
    'hermes-hooks:manage the Hermes Agent hook integration'
    'cursor-hooks:manage the Cursor Agent CLI hook integration'
    'hooks:manage the Claude hook integration'
    'group:manage groups'
    'worktree:manage git worktrees'
    'wt:manage git worktrees'
    'web:start the TUI with the web UI server'
    'remote:manage remote agent-deck instances'
    'conductor:manage conductor meta-agent orchestration'
    'openclaw:manage OpenClaw bridges'
    'oc:manage OpenClaw bridges'
