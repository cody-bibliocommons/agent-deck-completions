__agent_deck_remote_sessions() {
  # `remote attach <name> <session>`: the remote name is the previous word.
  local -a rsessions
  local remote=${words[CURRENT-1]}
  [[ -n $remote && $remote != -* ]] || return 1
  rsessions=( ${(f)"$(__agent_deck_json_field title remote sessions $remote --json)"} )
  _describe -t remote-sessions 'remote session' rsessions
}

__agent_deck_conductors() {
